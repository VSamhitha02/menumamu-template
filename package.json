{
  "name": "menumamu-templates",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "deploy:triguna": "cross-env NODE_ENV=production WORKER_NAME=$WORKER_NAME RESTAURANT=$RESTAURANT_ID pnpm run deploy:custom",
    "deploy:rest2": "cross-env NODE_ENV=production WORKER_NAME=menumamu-restaurant2 RESTAURANT=restaurant2 pnpm run deploy:custom",
    "deploy:custom": "pnpm run deploy:database:preview && pnpm run deploy:app:custom",
    "deploy:app:custom": "opennextjs-cloudflare build --env=$CLOUDFLARE_ENV && opennextjs-cloudflare deploy --name=$WORKER_NAME --env=$CLOUDFLARE_ENV",
    "deploy:database:preview": "cross-env CLOUDFLARE_ENV=preview PAYLOAD_SECRET=ignore payload migrate && wrangler d1 execute D1 --command 'PRAGMA optimize' --env=preview --remote",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbo",
    "dev:remote": "cross-env USE_REMOTE=true NODE_OPTIONS=--no-deprecation next dev --turbo",
    "devsafe": "rm -rf .next && rm -rf .open-next && cross-env NODE_OPTIONS=--no-deprecation next dev --turbo",
    "share": "npx cloudflared tunnel --url http://localhost:3000",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "build:worker": "opennextjs-cloudflare build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --env=$CLOUDFLARE_ENV",
    "deploy": "pnpm run deploy:database && pnpm run deploy:app",
    "deploy:app": "opennextjs-cloudflare build --env=$CLOUDFLARE_ENV && opennextjs-cloudflare deploy --env=$CLOUDFLARE_ENV",
    "deploy:database": "cross-env NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate && wrangler d1 execute D1 --command 'PRAGMA optimize' --env=$CLOUDFLARE_ENV --remote",
    "deploy:database:custom": "cross-env NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate && wrangler d1 execute D1 --command 'PRAGMA optimize' --env=$CLOUDFLARE_ENV --remote",
    "deploy:preview": "pnpm run deploy:database:preview && pnpm run deploy:app:preview",
    "deploy:app:preview": "opennextjs-cloudflare build --env=preview && opennextjs-cloudflare deploy --env=preview"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.14.6",
    "@payloadcms/db-d1-sqlite": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/payload-cloud": "3.90.2",
    "@payloadcms/plugin-form-builder": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-r2": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.56.0",
    "@tabler/icons-react": "^3.31.0",
    "@tailwindcss/postcss": "^4.0.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-state-city": "^3.2.1",
    "cross-env": "^7.0.3",
    "embla-carousel-react": "^8.5.2",
    "framer-motion": "^12.6.2",
    "graphql": "^16.8.1",
    "lucide-react": "^0.477.0",
    "motion": "^12.4.10",
    "next": "15.2.8",
    "payload": "3.90.2",
    "prism-react-renderer": "^2.4.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.54.2",
    "react-turnstile": "^1.1.4",
    "react-youtube": "^10.1.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/react-google-recaptcha": "^2.1.9",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.2.8",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "5.7.3",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
